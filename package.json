{
  "name": "phlix-docs",
  "version": "1.0.0",
  "description": "Phlix Media Server documentation — end-user, developer, and hub-admin guides",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs && node scripts/check-anchor-links.mjs",
    "docs:build:only": "vitepress build docs",
    "check:anchors": "node scripts/check-anchor-links.mjs",
    "docs:preview": "vitepress preview docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/detain/phlix-docs.git"
  },
  "keywords": [
    "phlix",
    "media-server",
    "documentation"
  ],
  "author": "",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/detain/phlix-docs/issues"
  },
  "homepage": "https://github.com/detain/phlix-docs#readme",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "vite": "^6.4.6",
    "esbuild": "^0.25.0",
    "@vue/server-renderer": "^3.5.42",
    "source-map-js": "^1.2.2"
  }
}
